# Copy this file to .env (gitignored) and fill in real values for LOCAL testing
# against real AWS/Slack/Anthropic. For the actual Lambda deployment, these are
# set as Lambda environment variables instead (see infra/deploy.md, step 5) -
# this file is a reference for what exists, not something Lambda reads directly.

# --- Required at runtime (lambda_handler.py) ---
BUCKET_NAME=your-sales-reporting-bucket

# --- LLM narrative (pipeline/narrative.py) ---
# Leave USE_MOCK_LLM=true (the default) to run the full pipeline for free with
# no API key, using a narrative grounded in the real computed metrics instead
# of a live model call. Set to false AND provide a real key to use Claude.
USE_MOCK_LLM=true
ANTHROPIC_API_KEY=

# --- Delivery (lambda_handler.py) ---
# Slack "Incoming Webhook" URL. If unset, Slack delivery is skipped (the report
# still generates and uploads to S3; the run does not fail).
SLACK_WEBHOOK_URL=

# --- Synthetic generator overrides (pipeline/synthetic_generator.py) ---
# Normally left unset: the generator advances one trading day per run with a
# fresh, logged seed. Set these only to force a specific reproducible day,
# e.g. for demos or debugging a specific past run (see CloudWatch logs for the
# seed actually used on any prior live run).
GENERATOR_SEED=
GENERATOR_EVENT=

# --- Local-only (not used inside the Lambda container itself) ---
# Where lambda_handler.py stages downloaded S3 state. The Dockerfile sets this to
# /tmp/work on Lambda; when unset it defaults to <system temp>/reporting-work
# (works on Windows, macOS and Linux). Only set it for local testing.
# WORK_DIR=
